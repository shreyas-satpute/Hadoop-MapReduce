from collections import deque

def dgim(s, k):
    b = deque()
    t = 0
    for x in s:
        t += 1
        if x == '1':
            b.appendleft([t, 1])
            i = 0
            while i + 2 < len(b):
                if b[i][1] == b[i+1][1] == b[i+2][1]:
                    b[i+2][1] *= 2
                    b.remove(b[i+1])
                else: break
    return sum(x[1] for x in b if x[0] > t-k)

s = input("Enter bit stream: ")
k = int(input("Last N bits: "))
print("Estimated 1s:", dgim(s, k))

